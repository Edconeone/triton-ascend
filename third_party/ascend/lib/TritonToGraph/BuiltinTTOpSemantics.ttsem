# Pointwise binary operations use one higher-order semantic constructor. The
# concrete op name and semantic attributes remain in its payload, so the
# solver may commute the same operation through layout permutations without
# equating different arithmetic functions.
semantics pure arith.addf(lhs, rhs) {
  import = and(float_element(result), same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(witnessed_operation(), float_element(result),
                  same_type(result, lhs), same_type(result, rhs));
  value = apply_binary(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

