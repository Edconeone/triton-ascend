# Target memory forms are part of the same semantic language as TTIR memory
# forms.  They are not optimization patterns: both sides describe an address,
# a lane mask and a MemoryState transition.  Bounded enumeration can therefore
# discover that splat(base)+addptr(offsets)+tt.load/store has the same meaning
# as one indirect target operation without a StridedLoadStore matcher.
semantics read(src) ascend.indirect_load(src, offsets) {
  import = and(scalar(src), pointer_element(src), ranked_tensor(offsets),
               integer_element(offsets), ranked_tensor(result),
               same_shape(result, offsets),
               pointer_pointee_element_type(result, src),
               attribute_boolean_equals(isVolatile, false));
  candidate = and(offline_only(), scalar(src), pointer_element(src),
                  ranked_tensor(offsets), integer_element(offsets),
                  ranked_tensor(result), same_shape(result, offsets),
                  pointer_pointee_element_type(result, src),
                  attribute(operandSegmentSizes,
                            indirect_load_segments_unmasked),
                  attribute(isVolatile, indirect_load_volatile),
                  attribute_boolean_equals(isVolatile, false));
  value = memory_read(pointer_add(value(src), value(offsets)));
  valid = and(valid(src), valid(offsets),
              memory_valid(pointer_add(value(src), value(offsets))));
  effect = memory_read(pointer_add(value(src), value(offsets)));
}

semantics read(src, mask) ascend.indirect_load(src, offsets, mask) {
  import = and(scalar(src), pointer_element(src), ranked_tensor(offsets),
               integer_element(offsets), ranked_tensor(result),
               same_shape(result, offsets), integer_bits(mask, 1),
               same_shape(result, mask),
               pointer_pointee_element_type(result, src),
               attribute_boolean_equals(isVolatile, false));
  candidate = and(offline_only(), scalar(src), pointer_element(src),
                  ranked_tensor(offsets), integer_element(offsets),
                  ranked_tensor(result), same_shape(result, offsets),
                  integer_bits(mask, 1), same_shape(result, mask),
                  pointer_pointee_element_type(result, src),
                  attribute(operandSegmentSizes,
                            indirect_load_segments_masked),
                  attribute(isVolatile, indirect_load_volatile),
                  attribute_boolean_equals(isVolatile, false));
  value = select(value(mask),
                 memory_read(pointer_add(value(src), value(offsets))),
                 undefined_value());
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(src), valid(offsets),
                         memory_valid(pointer_add(value(src), value(offsets)))),
                     false));
  effect = select(value(mask),
                  memory_read(pointer_add(value(src), value(offsets))), true);
}

semantics read(src, mask)
    ascend.indirect_load(src, offsets, mask, other) {
  import = and(scalar(src), pointer_element(src), ranked_tensor(offsets),
               integer_element(offsets), ranked_tensor(result),
               same_shape(result, offsets), integer_bits(mask, 1),
               same_shape(result, mask), same_type(result, other),
               pointer_pointee_element_type(result, src),
               attribute_boolean_equals(isVolatile, false));
  candidate = and(offline_only(), scalar(src), pointer_element(src),
                  ranked_tensor(offsets), integer_element(offsets),
                  ranked_tensor(result), same_shape(result, offsets),
                  integer_bits(mask, 1), same_shape(result, mask),
                  same_type(result, other),
                  pointer_pointee_element_type(result, src),
                  attribute(operandSegmentSizes,
                            indirect_load_segments_other),
                  attribute(isVolatile, indirect_load_volatile),
                  attribute_boolean_equals(isVolatile, false));
  value = select(value(mask),
                 memory_read(pointer_add(value(src), value(offsets))),
                 value(other));
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(src), valid(offsets),
                         memory_valid(pointer_add(value(src), value(offsets)))),
                     valid(other)));
  effect = select(value(mask),
                  memory_read(pointer_add(value(src), value(offsets))), true);
}

semantics write(src, value)
    ascend.indirect_store(src, offsets, value) {
  lane_domain = value;
  import = and(scalar(src), pointer_element(src), ranked_tensor(offsets),
               integer_element(offsets), ranked_tensor(value),
               same_shape(value, offsets),
               pointer_pointee_element_type(value, src));
  candidate = and(offline_only(), memory_state(result), scalar(src),
                  pointer_element(src), ranked_tensor(offsets),
                  integer_element(offsets), ranked_tensor(value),
                  same_shape(value, offsets),
                  pointer_pointee_element_type(value, src));
  value = memory_write(pointer_add(value(src), value(offsets)), value(value));
  valid = and(valid(src), valid(offsets), valid(value),
              memory_valid(pointer_add(value(src), value(offsets))));
  memory = memory_write(pointer_add(value(src), value(offsets)), value(value));
  memory_valid = and(valid(src), valid(offsets), valid(value),
                     memory_valid(pointer_add(value(src), value(offsets))));
}

semantics write(src, value)
    ascend.indirect_store(src, offsets, value, mask) {
  lane_domain = value;
  import = and(scalar(src), pointer_element(src), ranked_tensor(offsets),
               integer_element(offsets), ranked_tensor(value),
               same_shape(value, offsets), integer_bits(mask, 1),
               same_shape(value, mask),
               pointer_pointee_element_type(value, src));
  candidate = and(offline_only(), memory_state(result), scalar(src),
                  pointer_element(src), ranked_tensor(offsets),
                  integer_element(offsets), ranked_tensor(value),
                  same_shape(value, offsets), integer_bits(mask, 1),
                  same_shape(value, mask),
                  pointer_pointee_element_type(value, src));
  value = memory_write(pointer_add(value(src), value(offsets)), value(value),
                       value(mask));
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(src), valid(offsets), valid(value),
                         memory_valid(pointer_add(value(src), value(offsets)))),
                     true));
  memory = memory_write(pointer_add(value(src), value(offsets)), value(value),
                        value(mask));
  memory_valid = and(valid(mask),
                     select(value(mask),
                            and(valid(src), valid(offsets), valid(value),
                                memory_valid(pointer_add(value(src),
                                                         value(offsets)))),
                            true));
}

semantics read(pointer) tt.load(pointer) {
  import = and(load_result(result, pointer),
               attribute_absent_or_empty(boundaryCheck),
               attribute_absent(padding),
               attribute_absent_or_false(isVolatile));
  candidate = and(witnessed_operation(), load_result(result, pointer),
                  attribute(operandSegmentSizes, load_segments_unmasked),
                  attribute_absent_or_empty(boundaryCheck),
                  attribute_absent(padding),
                  attribute_absent_or_false(isVolatile));
  explore = true;
  value = memory_read(value(pointer));
  valid = and(valid(pointer), memory_valid(value(pointer)));
}

semantics read(pointer, mask) tt.load(pointer, mask) {
  import = and(load_result(result, pointer),
               integer_bits(mask, 1),
               same_container(result, mask),
               attribute_absent_or_empty(boundaryCheck),
               attribute_absent(padding),
               attribute_absent_or_false(isVolatile));
  candidate = and(witnessed_operation(),
                  attribute(operandSegmentSizes, load_segments_masked),
                  load_result(result, pointer),
                  integer_bits(mask, 1),
                  same_container(result, mask),
                  attribute_absent_or_empty(boundaryCheck),
                  attribute_absent(padding),
                  attribute_absent_or_false(isVolatile));
  explore = true;
  value = select(value(mask),
                 memory_read(value(pointer)),
                 undefined_value());
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(pointer), memory_valid(value(pointer))),
                     false));
}

semantics read(pointer, mask) tt.load(pointer, mask, other) {
  import = and(load_result(result, pointer),
               integer_bits(mask, 1),
               same_container(result, mask),
               same_type(result, other),
               attribute_absent_or_empty(boundaryCheck),
               attribute_absent(padding),
               attribute_absent_or_false(isVolatile));
  candidate = and(witnessed_operation(),
                  attribute(operandSegmentSizes, load_segments_other),
                  load_result(result, pointer),
                  integer_bits(mask, 1),
                  same_container(result, mask),
                  same_type(result, other),
                  attribute_absent_or_empty(boundaryCheck),
                  attribute_absent(padding),
                  attribute_absent_or_false(isVolatile));
  explore = true;
  value = select(value(mask), memory_read(value(pointer)), value(other));
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(pointer), memory_valid(value(pointer))),
                     valid(other)));
}

semantics write(pointer, value) tt.store(pointer, value) {
  import = and(store_value(pointer, value),
               attribute_absent_or_empty(boundaryCheck));
  candidate = and(offline_only(),
                  memory_state(result),
                  store_value(pointer, value),
                  attribute_absent_or_empty(boundaryCheck));
  value = memory_write(value(pointer), value(value));
  valid = and(valid(pointer),
              valid(value),
              memory_valid(value(pointer)));
  memory = memory_write(value(pointer), value(value));
  memory_valid = and(valid(pointer),
                     valid(value),
                     memory_valid(value(pointer)));
}

semantics write(pointer, value, mask) tt.store(pointer, value, mask) {
  import = and(store_value(pointer, value),
               integer_bits(mask, 1),
               same_container(value, mask),
               attribute_absent_or_empty(boundaryCheck));
  candidate = and(offline_only(),
                  memory_state(result),
                  store_value(pointer, value),
                  integer_bits(mask, 1),
                  same_container(value, mask),
                  attribute_absent_or_empty(boundaryCheck));
  value = memory_write(value(pointer), value(value), value(mask));
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(pointer),
                         valid(value),
                         memory_valid(value(pointer))),
                     true));
  memory = memory_write(value(pointer), value(value), value(mask));
  memory_valid = and(valid(mask),
                     select(value(mask),
                            and(valid(pointer),
                                valid(value),
                                memory_valid(value(pointer))),
                            true));
}

semantics atomic(pointer, value) tt.atomic_rmw(pointer, value) {
  import = and(load_result(result, pointer), same_type(result, value));
  candidate = and(offline_only(),
                  attribute_i32(atomic_rmw_op, atomic_rmw_op),
                  attribute_i32(sem, memory_semantic),
                  attribute_i32(scope, memory_scope),
                  load_result(result, pointer),
                  same_type(result, value));
  value = memory_read(value(pointer));
  valid = and(valid(pointer),
              valid(value),
              memory_valid(value(pointer)));
  memory = memory_atomic(value(pointer), value(value));
  memory_valid = and(valid(pointer),
                     valid(value),
                     memory_valid(value(pointer)));
}

semantics atomic(pointer, value, mask) tt.atomic_rmw(pointer, value, mask) {
  import = and(load_result(result, pointer),
               same_type(result, value),
               integer_bits(mask, 1),
               same_container(result, mask));
  candidate = and(offline_only(),
                  attribute_i32(atomic_rmw_op, atomic_rmw_op),
                  attribute_i32(sem, memory_semantic),
                  attribute_i32(scope, memory_scope),
                  load_result(result, pointer),
                  same_type(result, value),
                  integer_bits(mask, 1),
                  same_container(result, mask));
  value = select(value(mask), memory_read(value(pointer)), undefined_value());
  valid = and(valid(mask),
              select(value(mask),
                     and(valid(pointer),
                         valid(value),
                         memory_valid(value(pointer))),
                     false));
  memory = memory_atomic_masked(value(pointer), value(value), value(mask));
  memory_valid = and(valid(mask),
                     select(value(mask),
                            and(valid(pointer),
                                valid(value),
                                memory_valid(value(pointer))),
                            true));
}

semantics atomic(pointer, compare, value) tt.atomic_cas(pointer, compare, value) {
  import = and(load_result(result, pointer),
               same_type(result, compare),
               same_type(result, value));
  candidate = and(offline_only(),
                  attribute_i32(sem, memory_semantic),
                  attribute_i32(scope, memory_scope),
                  load_result(result, pointer),
                  same_type(result, compare),
                  same_type(result, value));
  value = memory_read(value(pointer));
  valid = and(valid(pointer),
              valid(compare),
              valid(value),
              memory_valid(value(pointer)));
  memory = memory_atomic(value(pointer), value(compare), value(value));
  memory_valid = and(valid(pointer),
                     valid(compare),
                     valid(value),
                     memory_valid(value(pointer)));
}

semantics pure tt.make_range() {
  import = integer_element(result);
  candidate = and(offline_only(),
                  attribute_i32(start, range_start),
                  attribute_i32(end, range_end),
                  rank(result, 1),
                  static_shape(result),
                  integer_bits(result, 32),
                  make_range_shape(result, start, end));
  shareable = true;
  value = add(result_index(0), attr_int(start));
  valid = true;
}

semantics pure tt.expand_dims(input) {
  import = and(integer_element(result), expand_dims_shape(input, result, axis));
  candidate = and(offline_only(),
                  witnessed_operation(),
                  attribute_i32(axis, axis),
                  integer_element(result),
                  expand_dims_shape(input, result, axis));
  shareable = true;
  value = expand_dims_value(input, axis);
  valid = expand_dims_valid(input, axis);
}

semantics pure tt.broadcast(input) {
  import = and(integer_element(result), broadcast_shape(input, result));
  candidate = and(offline_only(),
                  integer_element(result),
                  same_element_type(result, input),
                  broadcast_shape(input, result));
  shareable = true;
  value = broadcast_value(input);
  valid = broadcast_valid(input);
}

# Index-only permutation. Candidate attributes (notably `order`) are reused
# from a real operation already present in the semantic island by the generic
# TTIR language.
semantics pure tt.trans(input) {
  import = transpose_shape(input, result, order);
  candidate = and(witnessed_operation(),
                  attribute(order, transpose_order),
                  same_element_type(result, input),
                  same_encoding(result, input),
                  transpose_shape(input, result, order));
  value = transpose_value(input, order);
  valid = transpose_valid(input, order);
}

# Logical tensor assembly/indexing semantics.  These clauses are deliberately
# expressed as coordinate maps, so the generic enumerator can discover, for
# example, split(join(a, b)) == (a, b) without a join/split peephole matcher.
semantics pure tt.cat(lhs, rhs) {
  import = cat_shape(lhs, rhs, result);
  candidate = and(offline_only(), cat_shape(lhs, rhs, result));
  value = cat_value(lhs, rhs);
  valid = cat_valid(lhs, rhs);
}

semantics pure tt.join(lhs, rhs) {
  import = join_shape(lhs, rhs, result);
  candidate = and(offline_only(), join_shape(lhs, rhs, result));
  value = join_value(lhs, rhs);
  valid = join_valid(lhs, rhs);
}

semantics pure tt.split(input) {
  result_index = 0;
  operation_results = tuple(split_like(input), split_like(input));
  import = and(semantic_result(0), split_shape(input, result));
  candidate = and(offline_only(), semantic_result(0),
                  split_shape(input, result));
  value = split_value(input, 0);
  valid = split_valid(input, 0);
}

semantics pure tt.split(input) {
  result_index = 1;
  operation_results = tuple(split_like(input), split_like(input));
  import = and(semantic_result(1), split_shape(input, result));
  candidate = and(offline_only(), semantic_result(1),
                  split_shape(input, result));
  value = split_value(input, 1);
  valid = split_valid(input, 1);
}

semantics pure tt.gather(source, indices) {
  import = and(attribute(axis, axis),
               gather_shape(source, indices, result, axis));
  candidate = and(offline_only(), attribute_i32(axis, axis),
                  gather_shape(source, indices, result, axis));
  value = gather_value(source, indices, axis);
  valid = gather_valid(source, indices, axis);
}

# Exact rank-2 IEEE dot.  Approximate input modes and scaled-dot remain outside
# this clause until their rounding/scaling semantics are executable; they are
# therefore rejected rather than silently proved with real-number algebra.
semantics pure tt.dot(lhs, rhs, acc) {
  import = and(attribute_integer_equals(inputPrecision, 2),
               attribute_integer_equals(maxNumImpreciseAcc, 0),
               dot_shape(lhs, rhs, acc, result));
  candidate = and(offline_only(),
                  attribute_i32(inputPrecision, input_precision),
                  attribute_integer_equals(inputPrecision, 2),
                  attribute_i32(maxNumImpreciseAcc, max_imprecise_acc),
                  attribute_integer_equals(maxNumImpreciseAcc, 0),
                  dot_shape(lhs, rhs, acc, result));
  value = dot_value(lhs, rhs, acc);
  valid = dot_valid(lhs, rhs, acc);
}

semantics pure tt.dot_scaled(lhs, rhs, accumulator) {
  search = import_only;
  import = and(segments_equal(operandSegmentSizes, 1, 1, 1, 0, 0),
               attribute_optional(a_elem_type),
               attribute_optional(b_elem_type),
               attribute_optional(fastMath),
               attribute_optional(lhs_k_pack),
               attribute_optional(rhs_k_pack));
  value = dot_scaled_value(lhs, rhs, accumulator);
  valid = dot_scaled_valid(lhs, rhs, accumulator);
}

semantics pure tt.dot_scaled(lhs, rhs, accumulator, lhs_scale) {
  search = import_only;
  import = and(segments_equal(operandSegmentSizes, 1, 1, 1, 1, 0),
               attribute_optional(a_elem_type),
               attribute_optional(b_elem_type),
               attribute_optional(fastMath),
               attribute_optional(lhs_k_pack),
               attribute_optional(rhs_k_pack));
  value = dot_scaled_value(lhs, rhs, accumulator, lhs_scale);
  valid = dot_scaled_valid(lhs, rhs, accumulator, lhs_scale);
}

semantics pure tt.dot_scaled(lhs, rhs, accumulator, rhs_scale) {
  search = import_only;
  import = and(segments_equal(operandSegmentSizes, 1, 1, 1, 0, 1),
               attribute_optional(a_elem_type),
               attribute_optional(b_elem_type),
               attribute_optional(fastMath),
               attribute_optional(lhs_k_pack),
               attribute_optional(rhs_k_pack));
  value = dot_scaled_value(lhs, rhs, accumulator, rhs_scale);
  valid = dot_scaled_valid(lhs, rhs, accumulator, rhs_scale);
}

semantics pure tt.dot_scaled(lhs, rhs, accumulator, lhs_scale, rhs_scale) {
  search = import_only;
  import = and(segments_equal(operandSegmentSizes, 1, 1, 1, 1, 1),
               attribute_optional(a_elem_type),
               attribute_optional(b_elem_type),
               attribute_optional(fastMath),
               attribute_optional(lhs_k_pack),
               attribute_optional(rhs_k_pack));
  value = dot_scaled_value(lhs, rhs, accumulator, lhs_scale, rhs_scale);
  valid = dot_scaled_valid(lhs, rhs, accumulator, lhs_scale, rhs_scale);
}

# Arbitrary-result operations use an imported result signature: every concrete
# projection is represented and keyed, but no result arity is guessed by the
# finite enumerator.  Inline assembly and general scalar regions are opaque
# boundaries until their body language is executable.
semantics pure tt.elementwise_inline_asm(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  result_index = any;
  operation_results = imported;
  search = import_only;
  import = and(attribute_boolean_equals(pure, true),
               attribute(asm_string, inline_asm_text),
               attribute(constraints, inline_asm_constraints),
               attribute(packed_element, inline_asm_pack));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics observable tt.elementwise_inline_asm(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  result_index = any;
  operation_results = imported;
  search = import_only;
  import = and(attribute_boolean_equals(pure, false),
               attribute(asm_string, inline_asm_text),
               attribute(constraints, inline_asm_constraints),
               attribute(packed_element, inline_asm_pack));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics pure tt.map_elementwise(inputs) {
  variadic = inputs;
  result_index = any;
  operation_results = imported;
  region = imported;
  search = import_only;
  import = attribute_integer_equals(pack, 1);
  value = region_value();
  valid = region_valid();
}

# Packed scalar regions and effectful/unsupported bodies remain conservative
# import barriers.  This clause is disjoint from the executable pack=1 form.
semantics observable tt.map_elementwise(inputs) {
  variadic = inputs;
  result_index = any;
  operation_results = imported;
  region = imported;
  search = import_only;
  import = attribute_integer_not_equals(pack, 1);
  value = apply_nary();
  valid = all_operands_valid();
}

# Explicit physical-layout conversion. Layout alternatives come only from the
# finite tensor_encodings universe; the generic enumerator crosses those types
# with this schema. The operation changes representation, not logical value.
semantics pure ttg.convert_layout(input) {
  import = and(ranked_tensor(result), ranked_tensor(input),
               same_shape(result, input), same_element_type(result, input));
  candidate = and(offline_only(), ranked_tensor(result), ranked_tensor(input),
                  same_shape(result, input), same_element_type(result, input));
  shareable = true;
  value = value(input);
  valid = valid(input);
}

# Row-major shape-only transform. Encoded tensors are deliberately excluded
# until their physical layout map is represented explicitly.
semantics pure tt.reshape(input) {
  import = and(reshape_shape(input, result),
               attribute_absent(allow_reorder),
               attribute_absent(efficient_layout));
  candidate = and(offline_only(), reshape_shape(input, result),
                  attribute_absent(allow_reorder),
                  attribute_absent(efficient_layout));
  shareable = true;
  value = reshape_value(input);
  valid = reshape_valid(input);
}

# Static tensor and memref slices share one coordinate-map denotation.  The
# operation names remain declarative; the interpreter only knows that result
# coordinate i denotes source coordinate offset + i * stride.
semantics pure tensor.extract_slice(source) {
  import = slice_shape(source, result, static_offsets, static_sizes,
                       static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, slice_segments),
                  segments_equal(operandSegmentSizes, 1, 0, 0, 0),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  slice_shape(source, result, static_offsets, static_sizes,
                              static_strides));
  value = slice_value(source, static_offsets, static_sizes, static_strides);
  valid = slice_valid(source, static_offsets, static_sizes, static_strides);
}

# The final operand name is a one-or-more variadic tail. Its concrete arities
# are derived from UniverseSpec.max_operands; operandSegmentSizes partitions
# that tail into dynamic offsets, sizes and strides. No slice topology is
# encoded in the enumerator or materializer.
semantics pure tensor.extract_slice(source, dynamic) {
  variadic = dynamic;
  import = mixed_slice_shape(source, result, operandSegmentSizes,
                             static_offsets, static_sizes, static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, slice_segments),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  mixed_slice_shape(source, result, operandSegmentSizes,
                                    static_offsets, static_sizes,
                                    static_strides));
  value = mixed_slice_value(source, operandSegmentSizes, static_offsets,
                            static_sizes, static_strides);
  valid = mixed_slice_valid(source, operandSegmentSizes, static_offsets,
                            static_sizes, static_strides);
}

semantics pure memref.subview(source) {
  import = slice_shape(source, result, static_offsets, static_sizes,
                       static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, slice_segments),
                  segments_equal(operandSegmentSizes, 1, 0, 0, 0),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  slice_shape(source, result, static_offsets, static_sizes,
                              static_strides));
  shareable = true;
  value = slice_value(source, static_offsets, static_sizes, static_strides);
  valid = slice_valid(source, static_offsets, static_sizes, static_strides);
}

semantics pure memref.subview(source, dynamic) {
  variadic = dynamic;
  import = mixed_slice_shape(source, result, operandSegmentSizes,
                             static_offsets, static_sizes, static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, slice_segments),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  mixed_slice_shape(source, result, operandSegmentSizes,
                                    static_offsets, static_sizes,
                                    static_strides));
  shareable = true;
  value = mixed_slice_value(source, operandSegmentSizes, static_offsets,
                            static_sizes, static_strides);
  valid = mixed_slice_valid(source, operandSegmentSizes, static_offsets,
                            static_sizes, static_strides);
}

# `tensor.empty` contributes no value by itself. Its undefined lanes become
# observable only if a later consumer reads a lane that insert_slice did not
# cover, which prevents partially initialized candidates from proving equal.
semantics pure tensor.empty() {
  import = and(empty_shape(result), integer_or_float_element(result));
  candidate = and(offline_only(), empty_shape(result),
                  integer_or_float_element(result));
  value = undefined_value();
  valid = false;
}

# Initial construction fragment for static, rank-preserving, unit-stride
# slices. The generic evaluator interprets it as a pointwise overlay; this is
# sufficient for concatenation-shaped values without naming StoreCoalescing.
semantics pure tensor.insert_slice(source, destination) {
  import = insert_slice_shape(source, destination, result,
                              static_offsets, static_sizes, static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, insert_slice_segments),
                  segments_equal(operandSegmentSizes, 1, 1, 0, 0, 0),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  insert_slice_shape(source, destination, result,
                                     static_offsets, static_sizes,
                                     static_strides));
  value = insert_slice_value(source, destination,
                             static_offsets, static_sizes, static_strides);
  valid = insert_slice_valid(source, destination,
                             static_offsets, static_sizes, static_strides);
}

semantics pure tensor.insert_slice(source, destination, dynamic) {
  variadic = dynamic;
  import = mixed_insert_slice_shape(source, destination, result,
                                    operandSegmentSizes, static_offsets,
                                    static_sizes, static_strides);
  candidate = and(offline_only(),
                  attribute(operandSegmentSizes, insert_slice_segments),
                  attribute_i64_array(static_offsets, slice_offsets),
                  attribute_i64_array(static_sizes, slice_sizes),
                  attribute_i64_array(static_strides, slice_strides),
                  mixed_insert_slice_shape(source, destination, result,
                                           operandSegmentSizes,
                                           static_offsets, static_sizes,
                                           static_strides));
  value = mixed_insert_slice_value(source, destination, operandSegmentSizes,
                                   static_offsets, static_sizes,
                                   static_strides);
  valid = mixed_insert_slice_valid(source, destination, operandSegmentSizes,
                                   static_offsets, static_sizes,
                                   static_strides);
}

# Pointwise unary operations share one higher-order semantic form. The
# operation identity remains part of the denotation, so this proves commuting
# with index permutations but never confuses two different functions.
semantics pure arith.truncf(input) {
  import = and(float_element(result), float_element(input),
               same_shape(result, input), same_encoding(result, input),
               element_bits_less(result, input));
  candidate = and(witnessed_operation(),
                  float_element(result), float_element(input),
                  same_shape(result, input), same_encoding(result, input),
                  element_bits_less(result, input));
  value = apply_unary(value(input));
  valid = valid(input);
}

