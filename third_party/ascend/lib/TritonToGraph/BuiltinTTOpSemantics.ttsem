                  rectangular_index_pack(result, offset, stride0, stride1,
                                         numel0, numel1));
  value = select(
      rectangular_in_bounds(result_indices(), value(numel0), value(numel1)),
      memory_read(linear_address(value(src), value(offset), result_indices(),
