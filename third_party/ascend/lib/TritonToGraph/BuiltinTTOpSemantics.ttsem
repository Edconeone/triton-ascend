semantics pure tt.scan(input) {
  region = binary(arith.addi, tt.scan.return);
  import = and(integer_element(result),
               same_type(result, input),
               binary_scan(axis, reverse, arith.addi));
  # Scan carries a combiner region. It is a pure reusable semantic value; the
  # generic canonical-region recipe reconstructs the body for materialization
  # and target cost modeling.
  shareable = true;
  candidate = and(offline_only(),
                  witnessed_operation(),
                  attribute_i32(axis, axis),
                  attribute(reverse, reverse),
                  integer_element(result),
                  same_type(result, input),
                  binary_scan(axis, reverse, arith.addi));
  value = scan_sum(i, input, axis, reverse);
  valid = scan_all(i, input, axis, reverse);
}

# Region overloads are selected by their canonical body recipe, not by a C++
# operation-name matcher. Adding another finite combiner therefore extends
# only this semantic file; enumeration, proof and materialization are shared.
semantics pure tt.scan(input) {
  region = binary(arith.muli, tt.scan.return);
  import = and(integer_element(result),
               same_type(result, input),
               binary_scan(axis, reverse, arith.muli));
  shareable = true;
  candidate = and(offline_only(),
                  witnessed_operation(),
                  attribute_i32(axis, axis),
                  attribute(reverse, reverse),
                  integer_element(result),
                  same_type(result, input),
                  binary_scan(axis, reverse, arith.muli));
  value = scan_product(i, input, axis, reverse);
  valid = scan_all(i, input, axis, reverse);
}

semantics pure tt.reduce(input) {
  region = binary(arith.addi, tt.reduce.return);
  import = and(integer_element(result),
               binary_reduction(axis, arith.addi));
  candidate = and(offline_only(),
                  witnessed_operation(),
                  attribute_i32(axis, axis),
                  integer_element(result),
                  integer_element(input),
                  same_element_type(result, input),
                  binary_reduction(axis, arith.addi));
  value = reduce_sum(i, input, axis);
  valid = reduce_all(i, input, axis);
}

semantics pure tt.reduce(input) {
  region = binary(arith.muli, tt.reduce.return);
  import = and(integer_element(result),
               binary_reduction(axis, arith.muli));
  candidate = and(offline_only(),
                  witnessed_operation(),
                  attribute_i32(axis, axis),
                  integer_element(result),
                  integer_element(input),
                  same_element_type(result, input),
                  binary_reduction(axis, arith.muli));
  value = reduce_product(i, input, axis);
  valid = reduce_all(i, input, axis);
}

semantics pure tt.histogram(source) {
  import = and(rank(result, 1),
               static_shape(result),
               positive_dim(result, 0),
               integer_bits(result, 32),
               rank(source, 1),
               static_shape(source),
               positive_dim(source, 0),
               integer_bits(source, 32));
  candidate = and(offline_only(),
                  rank(result, 1),
                  static_shape(result),
                  positive_dim(result, 0),
                  integer_bits(result, 32),
                  rank(source, 1),
                  static_shape(source),
                  positive_dim(source, 0),
                  integer_bits(source, 32));
  value = sum(i, source,
              select(equal(at(source, i), result_index(0)), 1, 0));
  valid = forall(i, source, valid_at(source, i));
}

semantics pure tt.histogram(source, mask) {
  import = and(rank(result, 1),
               static_shape(result),
               positive_dim(result, 0),
               integer_bits(result, 32),
               rank(source, 1),
               static_shape(source),
               positive_dim(source, 0),
               integer_bits(source, 32),
               rank(mask, 1),
               static_shape(mask),
               integer_bits(mask, 1),
               same_shape(source, mask),
               same_encoding(source, mask));
  candidate = and(target_compile_on_91095(),
                  rank(result, 1),
                  static_shape(result),
                  positive_dim(result, 0),
                  integer_bits(result, 32),
                  rank(source, 1),
                  static_shape(source),
                  positive_dim(source, 0),
                  integer_bits(source, 32),
                  rank(mask, 1),
                  static_shape(mask),
                  integer_bits(mask, 1),
                  same_shape(source, mask),
                  same_encoding(source, mask));
  value = sum(i, source,
              select(and(at(mask, i),
                         equal(at(source, i), result_index(0))),
                     1, 0));
  valid = forall(i, source,
                 and(valid_at(mask, i),
                     select(at(mask, i), valid_at(source, i), true)));
}

# Multi-result operations are defined as semantic projections. The generic
# graph language carries the complete result signature, while result_index
# chooses the Value/Valid denotation of one SSA result. No result is dropped.
semantics pure arith.addui_extended(lhs, rhs) {
  result_index = 0;
  operation_results = tuple(same_as(lhs), bool_like(lhs));
  import = and(semantic_result(0), integer_element(result),
               same_type(result, lhs), same_type(result, rhs));
  candidate = and(offline_only(), witnessed_operation(), semantic_result(0),
                  integer_element(result), same_type(result, lhs),
                  same_type(result, rhs));
  value = add(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.addui_extended(lhs, rhs) {
  result_index = 1;
  operation_results = tuple(same_as(lhs), bool_like(lhs));
  import = and(semantic_result(1), integer_bits(result, 1),
               same_container(result, lhs), same_type(lhs, rhs));
  candidate = and(offline_only(), witnessed_operation(), semantic_result(1),
                  integer_bits(result, 1), same_container(result, lhs),
                  same_type(lhs, rhs));
  value = unsigned_add_overflow(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

