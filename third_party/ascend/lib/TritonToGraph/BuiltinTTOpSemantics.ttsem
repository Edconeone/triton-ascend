          rectangular_in_bounds(result_indices(), value(numel0),
                                value(numel1)),
          and(valid(src), valid(offset), valid(stride0), valid(stride1),
              memory_valid(linear_address(
                  value(src), value(offset), result_indices(),
                  value(stride0), value(stride1)))),
          valid(other)));
  effect = select(
      rectangular_in_bounds(result_indices(), value(numel0), value(numel1)),
