# TTIR denotational semantics used by AutoGraphSolver.
#
# This file defines what one operation means. It must not describe a source
# graph, a replacement graph, or a workload-specific optimization.

semantics pure ags.input() {
  import = false;
  search = import_only;
  value = input_value();
  # The current compute-island contract admits ordinary TTIR values at its
  # boundary. Operations carrying explicit poison-producing promises are
  # rejected before they can become part of the island.
  valid = true;
}

# Synthetic boundary terminal for storage created by a private allocation in
# the current block.  It is materialized by reusing that allocation exactly as
# ags.input reuses an ordinary boundary value.  The distinct denotation lets
# the generic buffer algebra prove that writes through two different private
# allocation identities cannot alias; arbitrary ags.input memrefs remain
# conservatively possibly-aliasing.
semantics pure ags.private_buffer() {
  import = false;
  search = import_only;
  value = private_buffer_value();
  valid = true;
}

# Synthetic proof-language terminal for the memory state entering an offline
# semantic graph. It is never materialized as TTIR.
semantics pure ags.memory() {
  import = false;
  search = import_only;
  value = input_memory();
  valid = true;
}

# Quantified theorem variable for a MemoryState transition that satisfies the
# generic launch-partition preflight.  Unlike ags.memory, this node carries the
# exact axis/tail premise proved again when a RuleDB template is instantiated;
# it must never be emitted into user TTIR.
semantics pure ags.partitionable_memory() {
  import = false;
  candidate = and(offline_only(), memory_state(result),
                  attribute_i32(axis, launch_axis),
                  attribute_i32(ceil_div, launch_ceil_div));
  materialize = proof_only;
  value = partitionable_memory(axis, ceil_div);
  valid = true;
  effect = partitionable_memory(axis, ceil_div);
  memory = partitionable_memory(axis, ceil_div);
  memory_valid = true;
}

# Synthetic proof-language terminal for the kernel launch contract entering an
# offline graph. It carries grid/program-id meaning and is never materialized.
semantics pure ags.launch() {
  import = false;
  search = import_only;
  value = input_launch();
  valid = true;
}

# Optional launch contract supplied by the frontend/launcher. It makes the
# otherwise external relation between one grid extent and a scalar kernel
# argument part of the proof key. AGS never infers this relation from a guard.
semantics pure ags.launch_bound(bound) {
  import = false;
  candidate = and(offline_only(), state_operand(launch),
                  launch_state(result), scalar(bound),
                  integer_element(bound),
                  attribute_i32(axis, program_axis));
  materialize = proof_only;
  value = launch_bound(axis, value(bound));
  valid = valid(bound);
  launch = launch_bound(axis, value(bound));
  launch_valid = valid(bound);
}

semantics pure ags.launch_remap() {
  import = launch_state(result);
  candidate = and(offline_only(), state_operand(launch),
                  launch_state(result),
                  attribute_i32(axis, launch_axis),
                  attribute_i32(factor, launch_factor),
                  attribute_i32(ceil_div, launch_ceil_div));
  materialize = proof_only;
  action = module_attrs(
      set_attr_i32(hacc.coalesce_axis, axis),
      set_attr_i32(hacc.coalesce_factor, factor),
      set_attr_i32(hacc.coalesce_grid_ceil_div, ceil_div));
  value = input_launch();
  valid = true;
  launch = launch_remap(axis, factor, ceil_div);
  launch_valid = true;
}

# Synthetic whole-kernel proof root. It binds the final observable MemoryState
# to the LaunchState under which that state was produced. Search and proof may
# compare these roots, but the generic materializer must never emit ags.kernel
# into user IR.
semantics pure ags.kernel() {
  import = false;
  candidate = and(offline_only(), state_operand(memory),
                  state_operand(launch), memory_state(result));
  materialize = proof_only;
  value = kernel_effect(input_memory(), input_launch());
  valid = kernel_effect(input_memory_valid(), input_launch());
  effect = kernel_effect(input_effect(), input_launch());
  memory = kernel_effect(input_memory(), input_launch());
  memory_valid = kernel_effect(input_memory_valid(), input_launch());
  launch = kernel_effect(input_memory(), input_launch());
  launch_valid = kernel_effect(input_memory_valid(), input_launch());
}

# Compact higher-order launch-partition candidate. Its two state operands are
# the arbitrary per-program MemoryState and LaunchState selected by generic
# typed enumeration. No lane topology is encoded here: `kernel_partition` is
# a quantified semantic theorem, and `launch_partition` is its declarative
# online compiler action. Extending the finite factor/axis domains therefore
# needs no C++ matcher and no factor copies of the candidate graph.
semantics pure ags.kernel_partition() {
  import = false;
  candidate = and(offline_only(), state_operand(memory),
                  state_operand(launch), memory_state(result),
                  attribute_i32(axis, launch_axis),
                  attribute_i32(factor, launch_factor),
                  attribute_integer_greater(factor, 1),
                  attribute_i32(ceil_div, launch_ceil_div));
  materialize = proof_only;
  action = launch_partition(axis, factor, ceil_div);
  value = kernel_partition(input_memory(), input_launch(), axis, factor,
                           ceil_div);
  valid = kernel_partition(input_memory_valid(), input_launch(), axis, factor,
                           ceil_div);
  effect = kernel_partition(input_effect(), input_launch(), axis, factor,
                            ceil_div);
  memory = kernel_partition(input_memory(), input_launch(), axis, factor,
                            ceil_div);
  memory_valid = kernel_partition(input_memory_valid(), input_launch(), axis,
                                  factor, ceil_div);
  launch = kernel_partition(input_memory(), input_launch(), axis, factor,
                            ceil_div);
  launch_valid = kernel_partition(input_memory_valid(), input_launch(), axis,
                                  factor, ceil_div);
}

# Synthetic stage-local BufferState terminal. Stage adapters import concrete
# allocation/view state into this common proof token.
semantics pure ags.buffer() {
  import = false;
  search = import_only;
  value = input_buffer();
  valid = true;
}

# Stage-level buffer reads and writes use the same declarative state contract
# as TTIR memory effects, but remain a distinct proof domain. The generic
# stage adapter may import any operation whose signature is described here;
# no C12 graph topology is embedded in the solver.
semantics buffer_read(source) bufferization.to_tensor(source) {
  import = and(ranked_memref(source), ranked_tensor(result),
               same_shape(source, result),
               same_element_type(source, result));
  candidate = and(offline_only(), ranked_memref(source),
                  ranked_tensor(result), same_shape(source, result),
                  same_element_type(source, result),
                  state_operand(buffer));
  value = buffer_read(source);
  # MLIR memref SSA values are required to designate live storage at each
  # access. Alias/ownership/lifetime are checked by the online BufferState
  # materializer before it removes a transition; they are not value bits.
  valid = valid(source);
}

semantics buffer_write(target) memref.copy(source, target) {
  import = and(ranked_memref(source), ranked_memref(target),
               same_shape(source, target),
               same_element_type(source, target));
  candidate = and(offline_only(), buffer_state(result),
                  ranked_memref(source), ranked_memref(target),
                  same_shape(source, target),
                  same_element_type(source, target),
                  state_operand(buffer));
  value = buffer_write(value(target), buffer_read(source));
  valid = and(valid(source), valid(target));
  buffer = buffer_write(value(target), buffer_read(source));
  buffer_valid = and(valid(source), valid(target));
}

# A destination-style fill is a functional write of the scalar value to every
# coordinate of its memref output.  The common BufferState interpreter supplies
# the iteration space; no fill/concat topology is encoded here.
semantics buffer_write(target) linalg.fill(fill_value, target) {
  import = and(scalar(fill_value), ranked_memref(target),
               same_element_type(fill_value, target));
  candidate = and(offline_only(), buffer_state(result), scalar(fill_value),
                  ranked_memref(target),
                  same_element_type(fill_value, target),
                  state_operand(buffer));
  value = buffer_fill(target, value(fill_value));
  valid = and(valid(fill_value), valid(target));
  buffer = buffer_fill(target, value(fill_value));
  buffer_valid = and(valid(fill_value), valid(target));
}

# Generic projection for the MemoryState output carried by a stateful value
# node (notably atomic operations). It is a proof/search node, not TTIR.
semantics pure ags.memory_after(input) {
  import = false;
  candidate = and(offline_only(), memory_state(result),
                  producer_effect(input, atomic));
  value = memory_of(input);
  valid = memory_valid_of(input);
  memory = memory_of(input);
  memory_valid = memory_valid_of(input);
}

semantics pure arith.constant() {
  import = integer_constant(value);
  # Finite constants are seeded from the universe's integer_constants domain;
  # they are not produced by the generic schema/operand Cartesian product.
  search = import_only;
  shareable = true;
  value = constant(value);
  valid = true;
}

semantics pure arith.select(condition, true_value, false_value) {
  import = integer_or_float_element(result);
  candidate = and(integer_or_float_element(result),
                  integer_bits(condition, 1),
                  same_type(result, true_value),
                  same_type(result, false_value),
                  same_container(result, condition));
  value = select(value(condition), value(true_value), value(false_value));
  valid = and(valid(condition),
              select(value(condition), valid(true_value), valid(false_value)));
}

semantics pure arith.xori(lhs, rhs) {
  import = integer_element(result);
  candidate = and(integer_element(result),
                  same_type(result, lhs),
                  same_type(result, rhs));
  value = bit_xor(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.andi(lhs, rhs) {
  import = integer_element(result);
  candidate = and(integer_element(result),
                  same_type(result, lhs),
                  same_type(result, rhs));
  value = bit_and(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.ori(lhs, rhs) {
  import = integer_element(result);
  candidate = and(integer_element(result),
                  same_type(result, lhs),
                  same_type(result, rhs));
  value = bit_or(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.extui(input) {
  import = integer_element(result);
  # Zero extension is pure and deterministic, so a shared result may remain
  # inside a larger semantic island.  This lets the solver see both branches
  # of low-bit DAGs instead of committing a partial extui(trunci(x)) rewrite
  # before their common consumer is considered.
  shareable = true;
  candidate = and(integer_bits(result, 64),
                  integer_bits(input, 32),
                  same_container(result, input));
  value = zext(value(input));
  valid = valid(input);
}

semantics pure arith.extsi(input) {
  import = integer_element(result);
  candidate = and(offline_only(),
                  integer_element(result),
                  integer_element(input),
                  same_container(result, input),
                  element_bits_greater(result, input));
  value = sext(value(input));
  valid = valid(input);
}

semantics pure arith.trunci(input) {
  import = integer_element(result);
  candidate = and(integer_bits(result, 32),
                  integer_bits(input, 64),
                  same_container(result, input));
  value = trunc(value(input));
  valid = valid(input);
}

semantics pure arith.shrui(lhs, rhs) {
  import = and(integer_element(result),
               same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(integer_bits(result, 32),
                  same_type(result, lhs),
                  same_type(result, rhs));
  value = lshr(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs), shift_amount_valid(value(rhs)));
}

semantics pure arith.shrsi(lhs, rhs) {
  import = and(integer_element(result),
               same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(witnessed_operation(), integer_element(result),
                  same_type(result, lhs), same_type(result, rhs));
  value = ashr(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs), shift_amount_valid(value(rhs)));
}

semantics pure arith.addi(lhs, rhs) {
  import = and(integer_element(result), no_integer_overflow());
  candidate = and(offline_only(),
                  integer_element(result),
                  same_type(result, lhs),
                  same_type(result, rhs),
                  no_integer_overflow());
  shareable = true;
  value = add(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.muli(lhs, rhs) {
  import = and(integer_element(result), no_integer_overflow());
  candidate = and(witnessed_operation(), integer_element(result),
                  same_type(result, lhs), same_type(result, rhs),
                  no_integer_overflow());
  shareable = true;
  value = mul(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.remsi(lhs, rhs) {
  import = and(integer_element(result),
               same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(witnessed_operation(), integer_element(result),
                  same_type(result, lhs), same_type(result, rhs));
  value = srem(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs),
              signed_division_valid(value(lhs), value(rhs)));
}

semantics pure arith.subi(lhs, rhs) {
  import = and(integer_element(result), no_integer_overflow());
  candidate = and(integer_element(result),
                  same_type(result, lhs),
                  same_type(result, rhs),
                  no_integer_overflow());
  value = sub(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure arith.cmpi(lhs, rhs) {
  import = supported_integer_compare(predicate);
  # The legacy online beam copies the predicate from a witnessed compare.
  # Offline enumeration binds it to UniverseSpec.cmpi_predicate; the same
  # semantic predicate below rejects unsupported values in either path.
  candidate = and(witnessed_operation(),
                  attribute(predicate, cmpi_predicate),
                  supported_integer_compare(predicate),
                  integer_bits(result, 1),
                  integer_element(lhs),
                  same_type(lhs, rhs),
                  same_container(result, lhs));
  # Equality predicates are pure canonical facts.  Keeping a shared compare
  # inside the semantic island lets independent consumers refer to the same
  # fact without duplicating or pattern-matching those consumers.
  shareable = true;
  value = integer_compare(predicate, value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure tt.splat(input) {
  import = and(ranked_tensor(result), scalar(input),
               same_element_type(result, input));
  candidate = and(offline_only(),
                  ranked_tensor(result),
                  scalar(input),
                  same_element_type(result, input));
  shareable = true;
  value = value(input);
  valid = valid(input);
}

semantics pure tt.unsplat(input) {
  import = singleton_tensor_to_scalar(input, result);
  candidate = and(offline_only(),
                  singleton_tensor_to_scalar(input, result));
  shareable = true;
  value = singleton_value(input);
  valid = singleton_valid(input);
}

# Core Triton pointwise operations are described here, not in candidate
# discovery C++.  Opaque `apply_*` nodes retain the exact operation name,
# result type and semantic attributes in their payload.  That is sufficient
# to commute the same operation through index-only transforms without ever
# claiming that two different conversions or arithmetic functions are equal.
semantics pure tt.int_to_ptr(input) {
  import = and(pointer_element(result), integer_bits(input, 64),
               same_container(result, input));
  candidate = and(offline_only(), pointer_element(result),
                  integer_bits(input, 64), same_container(result, input));
  value = apply_unary(value(input));
  valid = valid(input);
}

semantics pure tt.ptr_to_int(input) {
  import = and(integer_bits(result, 64), pointer_element(input),
               same_container(result, input));
  candidate = and(offline_only(), integer_bits(result, 64),
                  pointer_element(input), same_container(result, input));
  value = apply_unary(value(input));
  valid = valid(input);
}

semantics pure tt.bitcast(input) {
  import = and(same_container(result, input),
               or(and(pointer_element(result), pointer_element(input),
                      same_memory_space(result, input)),
                  and(integer_or_float_element(result),
                      integer_or_float_element(input),
                      same_element_bits(result, input))));
  candidate = and(offline_only(), same_container(result, input),
                  or(and(pointer_element(result), pointer_element(input),
                         same_memory_space(result, input)),
                     and(integer_or_float_element(result),
                         integer_or_float_element(input),
                         same_element_bits(result, input))));
  value = apply_unary(value(input));
  valid = valid(input);
}

# A rounding attribute is always materialized for offline fp_to_fp candidates.
# This covers both widening and narrowing without relying on an implicit
# target default; imported widening operations may still omit the attribute.
semantics pure tt.fp_to_fp(input) {
  import = and(float_element(result), float_element(input),
               same_container(result, input),
               or(element_bits_greater(result, input),
                  same_element_bits(result, input),
                  attribute(rounding, rounding_mode)));
  candidate = and(offline_only(), attribute_i32(rounding, rounding_mode),
                  float_element(result), float_element(input),
                  same_container(result, input));
  value = apply_unary(value(input));
  valid = valid(input);
}

semantics pure tt.clampf(input, min_value, max_value) {
  import = and(float_element(result), same_type(result, input),
               same_type(result, min_value), same_type(result, max_value),
               attribute(propagateNan, propagate_nan));
  candidate = and(offline_only(),
                  attribute_i32(propagateNan, propagate_nan),
                  float_element(result), same_type(result, input),
                  same_type(result, min_value), same_type(result, max_value));
  value = apply_ternary(value(input), value(min_value), value(max_value));
  valid = and(valid(input), valid(min_value), valid(max_value));
}

semantics pure tt.precise_divf(lhs, rhs) {
  import = and(float_element(result), same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(offline_only(), float_element(result),
                  same_type(result, lhs), same_type(result, rhs));
  value = apply_binary(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure tt.mulhiui(lhs, rhs) {
  import = and(integer_element(result), same_type(result, lhs),
               same_type(result, rhs));
  candidate = and(offline_only(), integer_element(result),
                  same_type(result, lhs), same_type(result, rhs));
  value = unsigned_multiply_high(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

semantics pure tt.get_program_id() {
  import = integer_element(result);
  candidate = and(offline_only(), state_operand(launch),
                  attribute_i32(axis, program_axis),
                  integer_element(result));
  shareable = true;
  value = program_id(axis);
  valid = true;
}

# Grid size is launch state, not a free scalar. A factor>1 remap therefore
# remains non-equivalent when the remapped axis is observed, unless a future
# launch theorem explicitly proves the corresponding extent conversion.
semantics pure tt.get_num_programs() {
  import = integer_element(result);
  candidate = and(offline_only(), state_operand(launch),
                  attribute_i32(axis, program_axis),
                  integer_element(result));
  shareable = true;
  value = num_programs(axis);
  valid = true;
}

semantics pure tt.addptr(pointer, offset) {
  import = and(pointer_element(result),
               same_type(result, pointer),
               integer_element(offset),
               same_container(result, offset));
  candidate = and(witnessed_operation(),
                  pointer_element(result),
                  same_type(result, pointer),
                  integer_element(offset),
                  same_container(result, offset));
  explore = true;
  value = pointer_add(value(pointer), value(offset));
  valid = and(valid(pointer), valid(offset));
}

# Tensor-pointer construction has three equally-sized variadic groups
# (shape/stride/offset).  `operand_arity` is a language-level arity relation;
# the candidate enumerator itself remains unaware of this operation.
semantics pure tt.make_tensor_ptr(base, metadata) {
  variadic = metadata;
  operand_arity = sequence(4, 3);
  import = and(attribute(order, tensor_pointer_order),
               tensor_pointer_constructor(base, result, order));
  candidate = and(offline_only(),
                  attribute(order, tensor_pointer_order),
                  tensor_pointer_constructor(base, result, order));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics pure tt.advance(pointer, offsets) {
  variadic = offsets;
  import = tensor_pointer_advance(pointer, result);
  candidate = and(offline_only(),
                  tensor_pointer_advance(pointer, result));
  value = apply_nary();
  valid = all_operands_valid();
}

# Region terminators are structural syntax captured by CanonicalRegion.  They
# are not standalone candidates in the graph universe, but declaring them here
# makes the operation catalog explicit instead of misreporting them as missing
# mathematical semantics.
semantics pure tt.reduce.return(values) {
  variadic = values;
  operand_arity = sequence(0, 1);
  search = region_only;
  import = true;
  value = apply_nary();
  valid = all_operands_valid();
}

semantics pure tt.scan.return(values) {
  variadic = values;
  operand_arity = sequence(0, 1);
  search = region_only;
  import = true;
  value = apply_nary();
  valid = all_operands_valid();
}

semantics pure tt.map_elementwise.return(values) {
  variadic = values;
  operand_arity = sequence(0, 1);
  search = region_only;
  import = true;
  value = apply_nary();
  valid = all_operands_valid();
}

semantics pure tt.return(values) {
  variadic = values;
  operand_arity = sequence(0, 1);
  search = region_only;
  import = true;
  value = apply_nary();
  valid = all_operands_valid();
}

# Callable containers and their terminators are structural region syntax, not
# candidate graph nodes. Calls themselves are conservative observable
# boundaries because interprocedural summaries are not part of the TTIR
# island language yet.
semantics pure tt.func() {
  search = region_only;
  region = imported;
  import = true;
  value = apply_nary();
  valid = true;
}

semantics pure tt.call(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  result_index = any;
  operation_results = imported;
  search = import_only;
  import = and(attribute(callee, call_callee), callee_is_pure());
  value = call_summary_value();
  valid = call_summary_valid();
}

semantics observable tt.call(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  result_index = any;
  operation_results = imported;
  search = import_only;
  import = and(attribute(callee, call_callee), not(callee_is_pure()));
  value = apply_nary();
  valid = all_operands_valid();
}

# Debug/diagnostic operations are ordered observable actions.  They are
# intentionally import-only: AGS may preserve them in MemoryState and prove
# that surrounding rewrites do not cross the barrier, but never invents or
# removes a print/assert candidate.
semantics observable tt.print(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  search = import_only;
  import = and(attribute(prefix, print_prefix),
               attribute(hex, print_hex),
               attribute(isSigned, print_signedness));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics observable tt.assert(condition) {
  search = import_only;
  import = and(integer_bits(condition, 1),
               attribute(message, assert_message));
  value = apply_nary();
  valid = all_operands_valid();
}

# External calls remain opaque but their complete symbol identity participates
# in the denotation.  Pure calls may be imported as immutable values; impure
# calls also advance the ordered observable state.  Neither is synthesized by
# offline search because AGS cannot invent an ABI or implementation symbol.
semantics pure tt.extern_elementwise(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  search = import_only;
  import = and(attribute_boolean_equals(pure, true),
               attribute(libname, external_libname),
               attribute(libpath, external_libpath),
               attribute(symbol, external_symbol));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics observable tt.extern_elementwise(arguments) {
  variadic = arguments;
  operand_arity = sequence(0, 1);
  search = import_only;
  import = and(attribute_boolean_equals(pure, false),
               attribute(libname, external_libname),
               attribute(libpath, external_libpath),
               attribute(symbol, external_symbol));
  value = apply_nary();
  valid = all_operands_valid();
}

# Tensor descriptors are first-class opaque address-space handles.  Their
# block type and metadata arity are checked by reusable type predicates; all
# accesses use the same abstract key constructor, so reads and writes can be
# compared without a descriptor-operation matcher.
semantics pure tt.make_tensor_descriptor(base, metadata) {
  variadic = metadata;
  operand_arity = sequence(3, 2);
  import = and(tensor_descriptor(result),
               descriptor_base(base, result),
               descriptor_metadata(result, 1),
               attribute_optional(padding));
  candidate = and(offline_only(), tensor_descriptor(result),
                  descriptor_base(base, result),
                  descriptor_metadata(result, 1));
  value = apply_nary();
  valid = all_operands_valid();
}

semantics read(descriptor) tt.descriptor_load(descriptor, indices) {
  variadic = indices;
  import = and(descriptor_block_same(descriptor, result),
               descriptor_indices(descriptor, 1));
  candidate = and(offline_only(), state_operand(memory),
                  descriptor_block_same(descriptor, result),
                  descriptor_indices(descriptor, 1));
  value = memory_read(operation_key());
  valid = and(all_operands_valid(), memory_valid(operation_key()));
}

semantics write(descriptor, source)
    tt.descriptor_store(descriptor, source, indices) {
  variadic = indices;
  import = and(descriptor_block_same(descriptor, source),
               descriptor_indices(descriptor, 2));
  candidate = and(offline_only(), memory_state(result),
                  descriptor_block_same(descriptor, source),
                  descriptor_indices(descriptor, 2));
  value = memory_write(operation_key_except(1), value(source));
  valid = and(all_operands_valid(),
              memory_valid(operation_key_except(1)));
  memory = memory_write(operation_key_except(1), value(source));
  memory_valid = and(all_operands_valid(),
                     memory_valid(operation_key_except(1)));
}

semantics read(descriptor)
    tt.descriptor_gather(descriptor, x_offsets, y_offset) {
  import = and(descriptor_gather_shape(descriptor, x_offsets, result),
               integer_bits(y_offset, 32));
  candidate = and(offline_only(), state_operand(memory),
                  descriptor_gather_shape(descriptor, x_offsets, result),
                  integer_bits(y_offset, 32));
  value = memory_read(operation_key());
  valid = and(all_operands_valid(), memory_valid(operation_key()));
}

semantics write(descriptor, source)
    tt.descriptor_scatter(descriptor, x_offsets, y_offset, source) {
  lane_domain = source;
  import = and(descriptor_gather_shape(descriptor, x_offsets, source),
               integer_bits(y_offset, 32));
  candidate = and(offline_only(), memory_state(result),
                  descriptor_gather_shape(descriptor, x_offsets, source),
                  integer_bits(y_offset, 32));
  value = memory_write(operation_key_except(3), value(source));
  valid = and(all_operands_valid(),
              memory_valid(operation_key_except(3)));
  memory = memory_write(operation_key_except(3), value(source));
  memory_valid = and(all_operands_valid(),
                     memory_valid(operation_key_except(3)));
}

semantics write(descriptor, source)
    tt.descriptor_reduce(descriptor, source, indices) {
  variadic = indices;
  lane_domain = source;
  import = and(descriptor_block_same(descriptor, source),
               descriptor_indices(descriptor, 2),
               attribute_i32(kind, descriptor_reduce_kind));
  candidate = and(offline_only(), state_operand(memory),
                  descriptor_block_same(descriptor, source),
                  descriptor_indices(descriptor, 2),
                  attribute_i32(kind, descriptor_reduce_kind));
  value = memory_atomic(operation_key_except(1), value(source));
  valid = and(all_operands_valid(),
              memory_valid(operation_key_except(1)));
  memory = memory_atomic(operation_key_except(1), value(source));
  memory_valid = and(all_operands_valid(),
                     memory_valid(operation_key_except(1)));
}

# A rectangular strided access is defined by ordinary address arithmetic and
# an in-bounds predicate.  The five overloads are only the finite rank surface
# of the target OP (rank <= 5); candidate discovery and proof remain generic.
semantics read(src)
    ascend.stride_load(src, offset, other, stride0, numel0) {
  import = and(scalar(src), pointer_element(src), scalar(other),
               ranked_tensor(result), same_element_type(result, other),
               pointer_pointee_element_type(result, src),
               rectangular_index_pack(result, offset, stride0, numel0));
  candidate = and(offline_only(), scalar(src), pointer_element(src),
                  scalar(other), ranked_tensor(result),
                  same_element_type(result, other),
                  pointer_pointee_element_type(result, src),
                  rectangular_index_pack(result, offset, stride0, numel0));
  value = select(
      rectangular_in_bounds(result_indices(), value(numel0)),
      memory_read(linear_address(value(src), value(offset),
                                 result_indices(), value(stride0))),
      value(other));
  valid = and(
      valid(numel0),
      select(rectangular_in_bounds(result_indices(), value(numel0)),
             and(valid(src), valid(offset), valid(stride0),
                 memory_valid(linear_address(value(src), value(offset),
                                             result_indices(),
                                             value(stride0)))),
             valid(other)));
  effect = select(
      rectangular_in_bounds(result_indices(), value(numel0)),
      memory_read(linear_address(value(src), value(offset),
                                 result_indices(), value(stride0))),
      true);
}

