semantics write(dst, source)
    ascend.stride_store(dst, source, offset, stride0, numel0) {
  lane_domain = source;
  import = and(scalar(dst), pointer_element(dst), ranked_tensor(source),
               pointer_pointee_element_type(source, dst),
               rectangular_index_pack(source, offset, stride0, numel0));
  candidate = and(offline_only(), memory_state(result), scalar(dst),
                  pointer_element(dst), ranked_tensor(source),
                  pointer_pointee_element_type(source, dst),
                  rectangular_index_pack(source, offset, stride0, numel0));
  value = memory_write(
      linear_address(value(dst), value(offset), operand_indices(source),
                     value(stride0)),
      value(source),
      rectangular_in_bounds(operand_indices(source), value(numel0)));
  valid = and(
      valid(numel0),
      select(rectangular_in_bounds(operand_indices(source), value(numel0)),
             and(valid(dst), valid(source), valid(offset), valid(stride0),
                 memory_valid(linear_address(
                     value(dst), value(offset), operand_indices(source),
                     value(stride0)))),
             true));
  memory = memory_write(
      linear_address(value(dst), value(offset), operand_indices(source),
                     value(stride0)),
      value(source),
      rectangular_in_bounds(operand_indices(source), value(numel0)));
  memory_valid = and(
      valid(numel0),
      select(rectangular_in_bounds(operand_indices(source), value(numel0)),
