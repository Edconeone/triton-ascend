# Opaque pointwise denotations are still mathematical semantics: the payload
# contains the exact operation name, result type and semantic attributes.  The
# solver may move the same total function through index-only operators, but it
# cannot confuse different functions or invent algebraic identities for them.
# This is the generic coverage path for the long tail of Arith/Math TTOPs.
semantics pure arith.cmpf(lhs, rhs) {
  import = and(float_element(lhs), same_type(lhs, rhs),
               integer_bits(result, 1), same_container(result, lhs));
  candidate = and(witnessed_operation(),
                  attribute(predicate, cmpf_predicate),
                  float_element(lhs), same_type(lhs, rhs),
                  integer_bits(result, 1), same_container(result, lhs));
  value = apply_binary(value(lhs), value(rhs));
  valid = and(valid(lhs), valid(rhs));
}

